<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet_card"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@string/brand_name"
            android:src="@drawable/ic_logo" />

        <com.mianboor.app.GradientTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/orbitron_bold"
            android:letterSpacing="0.06"
            android:text="@string/brand_name"
            android:textSize="24sp"
            android:textStyle="bold"
            app:gtEndColor="@color/neon_blue"
            app:gtStartColor="@color/neon_pink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/gate_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/gate_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <!-- ورودی کد اشتراک عددی -->
        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_input"
            android:digits="0123456789"
            android:gravity="center"
            android:inputType="number"
            android:letterSpacing="0.12"
            android:maxLength="14"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:indeterminateTint="@color/neon_purple"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivate"
            style="@style/NeonButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="@string/activate" />

        <!-- جداکننده «یا» -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#26FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="@string/or"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#26FFFFFF" />
        </LinearLayout>

        <!-- گزینه ۱: خرید اشتراک -->
        <LinearLayout
            android:id="@+id/rowBuy"
            style="@style/GlassOptionRow"
            android:layout_marginTop="14dp">

            <ImageView
                style="@style/OptionIconBox"
                android:contentDescription="@string/buy_sub"
                android:src="@drawable/ic_cart"
                app:tint="@color/neon_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buy_sub"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/buy_sub_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- گزینه ۲: تست رایگان -->
        <LinearLayout
            android:id="@+id/rowTrial"
            style="@style/GlassOptionRow"
            android:layout_marginTop="10dp">

            <ImageView
                style="@style/OptionIconBox"
                android:contentDescription="@string/trial"
                android:src="@drawable/ic_clock"
                app:tint="@color/neon_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trial"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/trial_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- گزینه ۳: پشتیبانی -->
        <LinearLayout
            android:id="@+id/rowSupport"
            style="@style/GlassOptionRow"
            android:layout_marginTop="10dp">

            <ImageView
                style="@style/OptionIconBox"
                android:contentDescription="@string/support"
                android:src="@drawable/ic_support"
                app:tint="@color/neon_pink" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/support_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
