<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space">

    <!-- ستاره‌های فضایی -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_stars" />

    <!-- هاله نئون مرکزی -->
    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:background="@drawable/glow_center" />

    <!-- محتوای اسپلش -->
    <LinearLayout
        android:id="@+id/splashContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:contentDescription="@string/brand_name"
            android:src="@drawable/ic_logo" />

        <com.mianboor.app.GradientTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/orbitron_bold"
            android:letterSpacing="0.06"
            android:text="@string/brand_name"
            android:textSize="38sp"
            android:textStyle="bold"
            app:gtEndColor="@color/neon_blue"
            app:gtStartColor="@color/neon_pink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- عناصر HUD (ادای احترام به تصویر مرجع) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="44dp"
        android:text="@string/hud_top_start"
        android:theme="@style/HudText" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="20dp"
        android:text="@string/hud_top_end"
        android:theme="@style/HudText" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="40dp"
        android:text="@string/hud_bottom_start"
        android:theme="@style/HudText" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="40dp"
        android:text="@string/hud_bottom_end"
        android:theme="@style/HudText" />

    <ProgressBar
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:indeterminateTint="@color/neon_purple" />

    <!-- نمای قفل (وقتی پاپ‌آپ بسته شود) -->
    <LinearLayout
        android:id="@+id/lockedView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/bg_glass_strong"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="26dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock"
            app:tint="@color/neon_pink"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/locked_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/locked_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnlock"
            style="@style/NeonButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="@string/locked_btn" />

        <TextView
            android:id="@+id/btnExit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="6dp"
            android:text="@string/exit_app"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
